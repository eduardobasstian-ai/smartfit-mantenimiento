{
  "name": "smartfit-catalogo-desktop",
  "version": "0.1.12-beta.1",
  "description": "Beta de escritorio del catálogo de repuestos SmartFit",
  "author": "SmartFit",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "node preparar.cjs && electron-builder --win nsis --x64 --publish never",
    "test:updates": "node ../scripts/verificar-actualizaciones-catalogo.cjs"
  },
  "build": {
    "appId": "cl.smartfit.catalogo.beta",
    "productName": "Catálogo SmartFit Beta",
    "artifactName": "Catalogo-SmartFit-Beta-${version}-Setup.exe",
    "publish": [{ "provider": "github", "owner": "eduardobasstian-ai", "repo": "smartfit-mantenimiento", "releaseType": "prerelease", "channel": "beta" }],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "actualizaciones.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "contenido",
        "to": "catalogo",
        "filter": [
          "catalogo/**/*",
          "telemetry.js",
          "vendor/**/*"
        ]
      }
    ],
    "win": {
      "icon": "../IMG/pwa-512.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Catálogo SmartFit Beta",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
